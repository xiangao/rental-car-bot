[Unit]
Description=Rental-car price monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/projects/claude/rental-car-bot
ExecStart=%h/projects/claude/rental-car-bot/.venv/bin/python main.py
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
